<Application x:Class="DesktopTimeTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DesktopTimeTracker.Converters"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             Exit="OnExit"
             SessionEnding="OnSessionEnding">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary x:Name="ThemeDictionary" Source="Themes/Pink.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:DurationTextConverter x:Key="Duration" />
            <conv:DurationTextConverter x:Key="DurationCompact" Compact="True" />
            <conv:ClockConverter x:Key="Clock" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:RatioToHeightConverter x:Key="RatioHeight" />
            <conv:FallbackTextConverter x:Key="Fallback" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:RankConverter x:Key="Rank" />
            <conv:BooleanToVisibilityConverter x:Key="BoolVis" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolVis" Invert="True" />
            <conv:ExeIconConverter x:Key="ExeIcon" />
            <conv:ExeIconFallbackVisibilityConverter x:Key="ExeIconFallback" />
            <conv:CategoryBrushConverter x:Key="CategoryBrush" />
            <conv:RatioWidthConverter x:Key="RatioWidth" />
            <conv:EqualityConverter x:Key="Equal" />
        </ResourceDictionary>
    </Application.Resources>
</Application>