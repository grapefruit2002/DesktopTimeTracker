<Window x:Class="DesktopTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopTimeTracker.ViewModels"
        xmlns:ctl="clr-namespace:DesktopTimeTracker.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="桌面时长记录器"
        Width="1260" Height="840" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}">

    <!-- 隐藏系统标题栏/非客户区，但保留边缘拖拽缩放 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>

        <!-- Pack URI makes the bundled image load consistently in debug and published builds. -->
        <Image x:Name="BgImage" Source="pack://application:,,,/Assets/anime_bg.png" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Opacity="0.52" IsHitTestVisible="False" />

        <Grid Margin="20,18,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 自绘标题栏（拖拽区 + 窗口按钮） ================= -->
        <Grid Grid.Row="0" Margin="2,4,2,6" Background="Transparent"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 快捷：主题 / 桌宠 / 背景 / 保存 -->
                <Button Style="{DynamicResource WindowButton}" Content="🎨" ToolTip="切换主题"
                        Click="OnThemeQuickClick" />
                <Button Style="{DynamicResource WindowButton}" Content="🐾" ToolTip="桌宠模型"
                        Click="OnPetQuickClick" />
                <Button Style="{DynamicResource WindowButton}" Content="🖼" ToolTip="切换背景"
                        Click="OnBackgroundQuickClick" />
                <Button Style="{DynamicResource WindowButton}" Content="💾" ToolTip="保存设置"
                        Click="OnSaveQuickClick" />
                <Border Width="6" />
                <!-- 窗口控制 -->
                <Button Style="{DynamicResource WindowButton}" Content="─" ToolTip="最小化"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaxButton" Style="{DynamicResource WindowButton}" Content="▢" ToolTip="最大化"
                        Click="OnMaximizeClick" />
                <Button Style="{DynamicResource WindowButton}" Content="✕" ToolTip="关闭到托盘"
                        Foreground="{DynamicResource RedBrush}" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="20,16" Margin="0,0,0,8"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentDimBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="7">
                        <Image Source="Assets/app.ico" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </StackPanel>

                <!-- current activity -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前活动" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentAppText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="8,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentAppDurationText}" FontSize="11.5"
                                       Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentTitleText}" FontSize="11.5"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380" />
                    </StackPanel>
                </StackPanel>

                <!-- today totals + actions -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="今日活跃" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding TodayActiveText}" FontSize="23" FontWeight="Bold"
                                       Foreground="{DynamicResource GreenBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="离开" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding TodayAwayText}" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                        <Button Content="{Binding ToggleButtonText}" Style="{DynamicResource AccentButton}"
                                Command="{Binding ToggleTrackingCommand}" MinWidth="96" />
                        <Button Content="刷新" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= NOTICE + ERROR BANNERS ================= -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource InfoBackgroundBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="14,9" Margin="0,0,0,14"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ℹ" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding NoticeText}" Foreground="{StaticResource InfoTextBrush}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="知道了" Command="{Binding DismissNoticeCommand}"
                            Style="{StaticResource IconButton}" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="14,9" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="{StaticResource RedBrush}" FontSize="14" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= TABS ================= -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ========== TAB: 今日概览 ========== -->
            <TabItem Header="今日概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- stat cards -->
                        <UniformGrid Columns="6" Margin="-4,0,-4,14">
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="活跃时长" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding OverviewActiveText}" Style="{StaticResource BigNumber}"
                                               Foreground="{StaticResource GreenBrush}" FontSize="21" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="离开时长" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding OverviewAwayText}" Style="{StaticResource BigNumber}"
                                               Foreground="{StaticResource AmberBrush}" FontSize="21" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="使用时段" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding OverviewSpanText}" Style="{StaticResource BigNumber}"
                                               FontSize="19" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="应用数" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding AppCount}" Style="{StaticResource BigNumber}"
                                               Foreground="{StaticResource AccentBrush}" FontSize="21" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="网站数" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding WebCount}" Style="{StaticResource BigNumber}"
                                               Foreground="{StaticResource PurpleBrush}" FontSize="21" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="切换次数" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding SwitchCount}" Style="{StaticResource BigNumber}"
                                               FontSize="21" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- rankings -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="应用排行" Style="{StaticResource CardTitle}" Margin="0" />
                                        <TextBlock Text="Top 10" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                    </Grid>
                                    <TextBlock Text="今天还没有应用记录" Style="{StaticResource Muted}"
                                               Visibility="{Binding HasTopApps, Converter={StaticResource InverseBoolVis}}" />
                                    <ItemsControl ItemsSource="{Binding TopApps}" AlternationCount="100">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="6"
                                                            Background="{StaticResource CardAltBrush}" VerticalAlignment="Top">
                                                        <Grid>
                                                            <Image Source="{Binding ExePath, Converter={StaticResource ExeIcon}}"
                                                                   Width="16" Height="16" Margin="3" />
                                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Rank}}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{StaticResource SubTextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding ExePath, Converter={StaticResource ExeIconFallback}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="52" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                                            <TextBlock Grid.Column="1" Margin="10,0,8,0"
                                                                       Text="{Binding Seconds, Converter={StaticResource DurationCompact}}"
                                                                       Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                                                       Text="{Binding Share, Converter={StaticResource Percent}}"
                                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7,0,0"
                                                                     Value="{Binding Share}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="网站排行" Style="{StaticResource CardTitle}" Margin="0" />
                                        <TextBlock Text="Top 10" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                    </Grid>
                                    <TextBlock Text="今天还没有网页记录" Style="{StaticResource Muted}"
                                               Visibility="{Binding HasTopSites, Converter={StaticResource InverseBoolVis}}" />
                                    <ItemsControl ItemsSource="{Binding TopSites}" AlternationCount="100">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="6"
                                                            Background="{StaticResource PurpleDimBrush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource Rank}}"
                                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="52" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Domain}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Margin="10,0,8,0"
                                                                       Text="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                                                       Text="{Binding Share, Converter={StaticResource Percent}}"
                                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7,0,0"
                                                                     Value="{Binding Share}" Foreground="{StaticResource PurpleBrush}" />
                                                        <TextBlock Margin="0,5,0,0" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}">
                                                            <Run Text="{Binding Pages, Mode=OneWay}" /><Run Text=" 个不同页面" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- hour distribution -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="24 小时分布" Style="{StaticResource CardTitle}" Margin="0" />
                                    <TextBlock Text="跨小时会话按秒拆分归属" HorizontalAlignment="Right"
                                               Style="{StaticResource Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HourBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="88" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{StaticResource TrackBrush}" CornerRadius="4" VerticalAlignment="Stretch" />
                                                <Border VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                        Height="{Binding Ratio, Converter={StaticResource RatioHeight}, ConverterParameter=88}"
                                                        ToolTip="{Binding Text}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#F27BAE" Offset="0" />
                                                            <GradientStop Color="#A88BEB" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- category breakdown -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="分类占比" Style="{StaticResource CardTitle}" Margin="0" />
                                    <TextBlock Text="工作 / 娱乐 / 学习…" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                </Grid>
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="11" Height="22">
                                    <ItemsControl ItemsSource="{Binding Categories}" Height="22">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Share, Converter={StaticResource RatioWidth}, ConverterParameter=760}"
                                                        Height="22" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="10"
                                                    Padding="10,5" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" VerticalAlignment="Center" />
                                                    <TextBlock Margin="6,0,4,0" FontSize="12" Foreground="{StaticResource TextBrush}">
                                                        <Run Text="{Binding Category}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                                               Text="{Binding Seconds, Converter={StaticResource DurationCompact}, Mode=OneWay}" />
                                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"
                                                               Text="{Binding Share, Converter={StaticResource Percent}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- timeline -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="最近活动" Style="{StaticResource CardTitle}" Margin="0" />
                                    <TextBlock Text="最新 100 条" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                </Grid>
                                <TextBlock Text="暂无活动记录" Style="{StaticResource Muted}"
                                           Visibility="{Binding HasTimeline, Converter={StaticResource InverseBoolVis}}" />
                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Timeline}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="146" />
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="86" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI">
                                                            <Run Text="{Binding Start, Converter={StaticResource Clock}, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding End, Converter={StaticResource Clock}, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Border Grid.Column="1" CornerRadius="4" Padding="0,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Width="42">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWeb}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource PurpleDimBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock TextAlignment="Center" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="应用" />
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWeb}" Value="True">
                                                                                <Setter Property="Text" Value="网页" />
                                                                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                   Margin="8,0,10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                        <TextBlock Grid.Column="4" TextAlignment="Right" FontSize="12"
                                                                   Text="{Binding Seconds, Converter={StaticResource DurationCompact}}"
                                                                   Foreground="{StaticResource SubTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== TAB: 应用记录 ========== -->
            <TabItem Header="应用记录">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PrevDayCommand}" />
                                <ComboBox Width="132" Margin="6,0" ItemsSource="{Binding AvailableDays}"
                                          SelectedItem="{Binding SelectedDay}" />
                                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextDayCommand}" />
                                <Button Content="今天" Margin="8,0,0,0" Command="{Binding GoTodayCommand}"
                                        IsEnabled="{Binding IsTodaySelected, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Margin="16,0" MaxWidth="420" HorizontalAlignment="Left"
                                     Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                                     ToolTip="按应用名、窗口标题或路径搜索" />
                            <Border Grid.Column="2" Background="{StaticResource InputBrush}" CornerRadius="8" Padding="3"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="明细" Style="{StaticResource PillRadio}" GroupName="AppView"
                                                 IsChecked="{Binding AppGrouped, Converter={StaticResource InverseBool}}" />
                                    <RadioButton Content="汇总" Style="{StaticResource PillRadio}" GroupName="AppView"
                                                 IsChecked="{Binding AppGrouped}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding AppRowsHint}" Margin="14,0,0,0"
                                       Style="{StaticResource Muted}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ctl:RoundedClip.Enable="True">
                        <Grid>
                            <DataGrid ItemsSource="{Binding AppSessions}"
                                      Visibility="{Binding AppGrouped, Converter={StaticResource InverseBoolVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="开始" Width="92"
                                                        Binding="{Binding Start, Converter={StaticResource Clock}}" />
                                    <DataGridTextColumn Header="结束" Width="92"
                                                        Binding="{Binding End, Converter={StaticResource Clock}}" />
                                    <DataGridTextColumn Header="时长" Width="110"
                                                        Binding="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                    <DataGridTextColumn Header="应用" Width="170" Binding="{Binding ProcessName}" />
                                    <DataGridTextColumn Header="窗口标题" Width="*" Binding="{Binding WindowTitle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding WindowTitle}" />
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid ItemsSource="{Binding AppUsageRows}"
                                      Visibility="{Binding AppGrouped, Converter={StaticResource BoolVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="应用" Width="200" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="总时长" Width="130"
                                                        Binding="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                    <DataGridTextColumn Header="占比" Width="90"
                                                        Binding="{Binding Share, Converter={StaticResource Percent}}" />
                                    <DataGridTextColumn Header="会话数" Width="90" Binding="{Binding Sessions}" />
                                    <DataGridTemplateColumn Header="占比条" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Share}"
                                                             VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="程序路径" Width="*" Binding="{Binding ExePath}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding ExePath}" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== TAB: 网页记录 ========== -->
            <TabItem Header="网页记录">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PrevDayCommand}" />
                                <ComboBox Width="132" Margin="6,0" ItemsSource="{Binding AvailableDays}"
                                          SelectedItem="{Binding SelectedDay}" />
                                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextDayCommand}" />
                                <Button Content="今天" Margin="8,0,0,0" Command="{Binding GoTodayCommand}"
                                        IsEnabled="{Binding IsTodaySelected, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Margin="16,0" MaxWidth="420" HorizontalAlignment="Left"
                                     Text="{Binding WebSearch, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                                     ToolTip="按网址、域名或页面标题搜索" />
                            <Border Grid.Column="2" Background="{StaticResource InputBrush}" CornerRadius="8" Padding="3"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="明细" Style="{StaticResource PillRadio}" GroupName="WebView"
                                                 IsChecked="{Binding WebGrouped, Converter={StaticResource InverseBool}}" />
                                    <RadioButton Content="汇总" Style="{StaticResource PillRadio}" GroupName="WebView"
                                                 IsChecked="{Binding WebGrouped}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding WebRowsHint}" Margin="14,0,0,0"
                                       Style="{StaticResource Muted}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ctl:RoundedClip.Enable="True">
                        <Grid>
                            <DataGrid ItemsSource="{Binding WebSessions}"
                                      Visibility="{Binding WebGrouped, Converter={StaticResource InverseBoolVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="开始" Width="92"
                                                        Binding="{Binding Start, Converter={StaticResource Clock}}" />
                                    <DataGridTextColumn Header="结束" Width="92"
                                                        Binding="{Binding End, Converter={StaticResource Clock}}" />
                                    <DataGridTextColumn Header="时长" Width="104"
                                                        Binding="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                    <DataGridTextColumn Header="浏览器" Width="86" Binding="{Binding Browser}" />
                                    <DataGridTextColumn Header="域名" Width="180" Binding="{Binding Domain}" />
                                    <DataGridTextColumn Header="页面标题" Width="1.3*" Binding="{Binding Title}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Title}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="网址" Width="2*" Binding="{Binding Url}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Url}" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="58">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="打开" Padding="7,2" FontSize="11"
                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Url}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid ItemsSource="{Binding WebUsageRows}"
                                      Visibility="{Binding WebGrouped, Converter={StaticResource BoolVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="域名" Width="280" Binding="{Binding Domain}" />
                                    <DataGridTextColumn Header="总时长" Width="130"
                                                        Binding="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                    <DataGridTextColumn Header="占比" Width="90"
                                                        Binding="{Binding Share, Converter={StaticResource Percent}}" />
                                    <DataGridTextColumn Header="页面数" Width="90" Binding="{Binding Pages}" />
                                    <DataGridTemplateColumn Header="占比条" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Share}"
                                                             Foreground="{StaticResource PurpleBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,16,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== TAB: 每日统计 ========== -->
            <TabItem Header="每日统计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="最近 14 天活跃时长" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock Text="点击柱状图下方的日期可跳转到该天明细" HorizontalAlignment="Right"
                                           Style="{StaticResource Muted}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DayBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="100" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Text}" FontSize="10.5" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6" />
                                            <Border Grid.Row="1" Background="{StaticResource TrackBrush}" CornerRadius="5" />
                                            <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="5,5,0,0"
                                                    Height="{Binding Ratio, Converter={StaticResource RatioHeight}, ConverterParameter=100}"
                                                    ToolTip="{Binding Text}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                        <GradientStop Color="#5FC9A8" Offset="0" />
                                                        <GradientStop Color="#A8EBD4" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ctl:RoundedClip.Enable="True">
                        <DataGrid ItemsSource="{Binding Days}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日期" Width="120" Binding="{Binding Day}" />
                                <DataGridTextColumn Header="活跃时长" Width="130"
                                                    Binding="{Binding ActiveSeconds, Converter={StaticResource DurationCompact}}" />
                                <DataGridTextColumn Header="离开时长" Width="130"
                                                    Binding="{Binding AwaySeconds, Converter={StaticResource DurationCompact}}" />
                                <DataGridTextColumn Header="应用数" Width="86" Binding="{Binding AppCount}" />
                                <DataGridTextColumn Header="网站数" Width="86" Binding="{Binding WebCount}" />
                                <DataGridTextColumn Header="切换次数" Width="94" Binding="{Binding AppSwitches}" />
                                <DataGridTextColumn Header="首次活动" Width="100"
                                                    Binding="{Binding FirstStart, Converter={StaticResource Clock}}" />
                                <DataGridTextColumn Header="末次活动" Width="100"
                                                    Binding="{Binding LastEnd, Converter={StaticResource Clock}}" />
                                <DataGridTemplateColumn Header="" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="查看明细" Padding="9,3" FontSize="11.5" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Day}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== TAB: 趋势统计 ========== -->
            <TabItem Header="趋势统计">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="统计范围" Style="{StaticResource CardTitle}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <RadioButton Style="{StaticResource PillRadio}" GroupName="TrendRange" Content="近 7 天"
                                             IsChecked="{Binding TrendRangeDays, Converter={StaticResource Equal}, ConverterParameter=7, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource PillRadio}" GroupName="TrendRange" Content="近 30 天" Margin="6,0,0,0"
                                             IsChecked="{Binding TrendRangeDays, Converter={StaticResource Equal}, ConverterParameter=30, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="-4,0,-4,14">
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="总活跃" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding TrendTotalText}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource GreenBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="日均活跃" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding TrendAvgText}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="最活跃一天" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding TrendBestText}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource PurpleBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="每日活跃时长" Style="{StaticResource CardTitle}" Margin="0" />
                                    <TextBlock Text="点击柱子可跳转到当天明细" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding TrendBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Day}" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0" Margin="3,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="120" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Text}" FontSize="10" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6" />
                                                    <Border Grid.Row="1" Background="{StaticResource TrackBrush}" CornerRadius="5" />
                                                    <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="5,5,0,0"
                                                            Height="{Binding Ratio, Converter={StaticResource RatioHeight}, ConverterParameter=120}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#F27BAE" Offset="0" />
                                                                <GradientStop Color="#A88BEB" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                                               Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="区间应用排行" Style="{StaticResource CardTitle}" Margin="0" />
                                    <TextBlock Text="Top 10" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding TrendTopApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource CardAltBrush}" VerticalAlignment="Top">
                                                    <Image Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" Width="16" Height="16" Margin="3" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="52" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                                        <TextBlock Grid.Column="1" Margin="10,0,8,0" Text="{Binding Seconds, Converter={StaticResource DurationCompact}}" />
                                                        <TextBlock Grid.Column="2" TextAlignment="Right" Text="{Binding Share, Converter={StaticResource Percent}}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7,0,0" Value="{Binding Share}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== TAB: 设置 ========== -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="记录行为" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="离开判定阈值" />
                                            <TextBlock Text="超过该时间无键鼠输入即判定为离开" Style="{StaticResource Muted}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                  ItemsSource="{Binding IdleChoices}" ItemTemplate="{StaticResource OptionItemTemplate}"
                                                  SelectedValuePath="Value" SelectedValue="{Binding IdleThresholdSeconds}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="采样间隔" />
                                            <TextBlock Text="越短越精确，开销略高" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                  ItemsSource="{Binding PollChoices}" ItemTemplate="{StaticResource OptionItemTemplate}"
                                                  SelectedValuePath="Value" SelectedValue="{Binding PollIntervalMs}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="久坐提醒（分钟）" />
                                            <TextBlock Text="连续活跃达到该时长后提示休息；0 = 关闭，最大 480" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" VerticalAlignment="Center"
                                                 Text="{Binding BreakReminderMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="每日活跃目标（分钟）" />
                                            <TextBlock Text="达成后提示，概览页显示进度；0 = 关闭，最大 960" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" VerticalAlignment="Center"
                                                 Text="{Binding DailyGoalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="喝水提醒" />
                                            <TextBlock Text="按本地时钟整点提醒，与运行时长无关；例如 10,11,14,15,16,17"
                                                       Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox Content="开启" IsChecked="{Binding WaterReminderEnabled}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding WaterReminderHoursText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="记录浏览器网页（网址 / 标题 / 停留时长）"
                                              IsChecked="{Binding TrackWebPages}" />
                                    <TextBlock Text="通过 UI Automation 读取地址栏，仅支持 Chrome / Edge / Firefox 等主流浏览器。"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="27,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="启动与后台" Style="{StaticResource CardTitle}" />
                                    <CheckBox Content="开机自动启动（写入当前用户启动项）"
                                              IsChecked="{Binding AutoStartWithWindows}" Margin="0,0,0,10" />
                                    <CheckBox Content="启动时最小化到托盘" IsChecked="{Binding StartMinimized}" Margin="0,0,0,10" />
                                    <CheckBox Content="显示桌面小宠物（可拖动 / 点击互动）" IsChecked="{Binding ShowPet}" Margin="0,0,0,14" />
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,10">
                                        <TextBlock Text="点击窗口关闭按钮只会隐藏到托盘，记录继续。要完全退出请右键托盘图标选择“退出”。"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="人物模型" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding PetModelChoices}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id" SelectedValue="{Binding SelectedPetModelId}"
                                              AutomationProperties.Name="人物模型" />
                                    <Button Grid.Column="1" Content="导入 VRM 模型…" Margin="10,0,0,0"
                                            Command="{Binding ImportPetModelCommand}" />
                                </Grid>
                                <TextBlock Text="支持内嵌贴图的 VRM 0.x / 1.0 人形模型（最大 512 MB）。导入后保留原文件，选择人物后点击下方“保存设置”即可切换，无需重启。"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="所有人物共用现有窗口大小、动作和提示设置；模型身材比例不同，实际观感可能不同。"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding PetModelStatusText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="桌宠提示文案" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="点击桌宠时随机选取一句；每行一条，空行忽略，全部留空恢复默认。左键 / 右键合并触发，2 秒冷却防卡死。"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBox Text="{Binding PetClickLinesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="点击桌宠时的提示"
                                         AcceptsReturn="True" Height="140" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                <TextBlock Text="喝水、久坐、目标达成等定时提醒不受这里影响，由计时逻辑独立触发。"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="忽略的应用" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding IgnoredProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" Height="110" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                        <TextBlock Text="进程名，逗号或空格分隔，例如 explorer, SearchHost。被忽略的应用仍计入桌面活跃时长，但不生成记录。"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="应用分类" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding CategoryRulesText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" Height="110" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                        <TextBlock Text="每行一条规则：进程名或域名 = 分类，例如 idea64=工作、bilibili.com=娱乐。"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
                                    <TextBlock Text="分类可选：工作 / 沟通 / 上网 / 娱乐 / 学习 / 其他。未匹配的应用归「其他」，未匹配的网址归「上网」。"
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 背景 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="背景" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding BackgroundChoices}"
                                              SelectedValue="{Binding SelectedBackgroundId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name" />
                                    <Button Grid.Column="1" Content="导入图片…" Margin="10,0,0,0"
                                            Command="{Binding ImportBackgroundCommand}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBox Text="{Binding NewBackgroundName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160" />
                                    <Button Content="重命名" Margin="8,0,0,0" Command="{Binding RenameBackgroundCommand}" />
                                    <Button Content="删除" Margin="8,0,0,0" Command="{Binding DeleteBackgroundCommand}" />
                                    <Button Content="打开背景文件夹" Margin="8,0,0,0"
                                            Command="{Binding OpenBackgroundFolderCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="支持 png / jpg / jpeg / webp。也可以直接在背景文件夹内放入或重命名图片，切换到该背景时会自动识别。" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显示方式" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedBackgroundModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="铺满覆盖（推荐，不留白）" Tag="2" />
                                        <ComboBoxItem Content="铺满自适应（可能留白）" Tag="3" />
                                        <ComboBoxItem Content="角落：右上角" Tag="0" />
                                        <ComboBoxItem Content="角落：左下角" Tag="1" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BackgroundOpacity, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="数据库" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Content="打开目录" Command="{Binding OpenDatabaseFolderCommand}" />
                                        <Button Content="更改位置" Margin="8,0,0,0" Command="{Binding ChangeDatabasePathCommand}" />
                                        <Button Content="导出当日 CSV" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" />
                                        <Button Content="压缩" Margin="8,0,0,0" Command="{Binding VacuumCommand}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前大小：" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding DatabaseSizeText}" FontSize="12"
                                               Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Text="　·　表：app_sessions / web_sessions / daily_summary"
                                               Style="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 隐私说明 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="隐私说明" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"
                                           Text="所有数据只写入本机 SQLite 文件，程序不联网、不上传、不读取网页内容。浏览器的无痕 / InPrivate 窗口只记录时长，网址会被替换为“(隐私模式)”。配置文件位于下方路径，可直接编辑后重启。" />
                                <TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource Muted}"
                                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsFilePath}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="保存设置" Style="{StaticResource AccentButton}" MinWidth="110"
                                    Command="{Binding SaveSettingsCommand}" />
                            <TextBlock Text="{Binding SettingsStatusText}" Margin="14,0,0,0"
                                       Foreground="{StaticResource GreenBrush}" FontSize="12.5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= FOOTER ================= -->
        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Right"
                       Text="{Binding FlushIntervalText}" />
        </Grid>
        </Grid>

    </Grid>
</Window>
